# ============================================
# Spider AI — Environment Configuration
# ============================================

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Auth ---
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# --- Database ---
# Local dev: file:local.db (zero config)
# Production: set Turso URL + auth token
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- AI ---
# Get key from https://openrouter.ai
OPENROUTER_API_KEY=
# Any OpenRouter-supported model
AI_MODEL=openai/gpt-4o-mini
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7

# --- Voice TTS (Text-to-Speech) ---
# Provider: elevenlabs | openai | azure | google | disabled
VOICE_TTS_PROVIDER=elevenlabs

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# OpenAI TTS
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Voice STT (Speech-to-Text) ---
# Provider: whisper | assemblyai | google | browser (client-side Web Speech API only)
VOICE_STT_PROVIDER=browser

# OpenAI Whisper (also used for STT if provider=whisper)
# OPENAI_API_KEY above is reused
WHISPER_MODEL=whisper-1

# --- Security ---
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3000
# Request body size limit
BODY_LIMIT=10mb
